# Secrets
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Data layers and presentation outputs.
# Bronze (raw xlsx) and silver (tidy CSV) are large and fully regenerable —
# keep them local only. Gold is tiny (~600 KB for all competitions) and IS the
# data artifact the deployed dashboard reads, so it is committed to the repo
# for Streamlit Community Cloud to serve. (default-deny: ignore everything under
# data/, then re-include gold.)
data/*
!data/gold/
reports/

# Browser-driven Playwright tests — useful for local regression checks
# but not part of the public portfolio surface yet (no fixtures, depend on
# a populated data/gold/ tree). The pytest suite envisioned in ROADMAP
# (parser + builders + AppTest) will live elsewhere when it lands.
tests/

# OS / IDE
.DS_Store
.vscode/
.idea/
