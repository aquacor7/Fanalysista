# Secrets
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Data layers and presentation outputs.
# Bronze (raw xlsx) is large and only consumed by build_silver — keep it local.
# The dashboard reads from BOTH silver (matches.csv, appearances.csv — used by
# the schedule and appearance-level views) and gold, so BOTH are committed as
# the deployment data artifact (~4.4 MB total for all 10 competitions) for
# Streamlit Community Cloud to serve. (default-deny: ignore everything under
# data/, then re-include silver and gold.)
data/*
!data/silver/
!data/gold/
reports/

# Browser-driven Playwright tests — useful for local regression checks
# but not part of the public portfolio surface yet (no fixtures, depend on
# a populated data/gold/ tree). The pytest suite envisioned in ROADMAP
# (parser + builders + AppTest) will live elsewhere when it lands.
tests/

# OS / IDE
.DS_Store
.vscode/
.idea/
